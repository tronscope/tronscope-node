{
  "name": "tronscope",
  "version": "0.1.0",
  "description": "Official Node.js / TypeScript SDK for TronScope — TRON Energy rental API, wallet analyze, watchlist, and prepaid TRX (HMAC Platform API).",
  "license": "MIT",
  "author": "TronScope <hello@tronscope.io>",
  "homepage": "https://tronscope.io/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tronscope/tronscope-node.git"
  },
  "bugs": {
    "url": "https://github.com/tronscope/tronscope-node/issues"
  },
  "keywords": [
    "tron",
    "tronscope",
    "tron-api",
    "tron-energy",
    "energy-rental",
    "trc20",
    "usdt",
    "wallet",
    "watchlist",
    "hmac",
    "sdk",
    "nodejs",
    "typescript",
    "blockchain-api",
    "tron-sdk"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "test": "node --import tsx --test test/hmac.test.ts test/client.test.ts",
    "test:live": "TRONSCOPE_LIVE=1 node --import tsx --test --test-concurrency=1 test/live.test.ts",
    "test:all": "npm test && npm run test:live",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
